# =============================================================================
# HEALTHSETU — ENVIRONMENT CONFIGURATION (.env.example)
# Phase 17 Production & Staging Reference
# =============================================================================

# --- 1. APPLICATION ---
APP_NAME=healthsetu-backend
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
ENABLE_DOCS=true

# --- 2. DATABASE (Existing Supabase PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# For Supabase Transaction Pooler (PgBouncer port 6543) or Direct (port 5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthsetu_dev

# Connection Pooling Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# --- 3. API & ROUTING ---
API_PREFIX=/api/v1
REQUEST_ID_HEADER=X-Request-ID
MAX_REQUEST_SIZE_BYTES=10485760

# --- 4. CORS CONFIGURATION ---
# In production, explicit origins: https://healthsetu.com,https://www.healthsetu.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://healthsetu.com,https://www.healthsetu.com,https://health-setu-giaa.vercel.app

# --- 5. LOGGING & OBSERVABILITY ---
LOG_LEVEL=INFO
PHI_SAFE_LOGGING_ENABLED=true

# --- 6. AUTHENTICATION & SECURITY (Phase 2 & Phase 15) ---
# Generate 32+ bytes random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASHING_SCHEME=argon2id
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
SECURITY_HEADERS_ENABLED=true
STRICT_TRANSPORT_SECURITY_ENABLED=true
AUDIT_ENABLED=true

# --- 7. DOCUMENT STORAGE & OCR (Phase 5) ---
MAX_DOCUMENT_SIZE_MB=20
MAX_DOCUMENT_PAGES=50
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=data/documents
DOCUMENT_PRIVATE_STORAGE=false
OCR_PROVIDER=local
OCR_TIMEOUT_SECONDS=120
DOCUMENT_PROCESSING_ENABLED=true
MAX_PROCESSING_RETRIES=3
MALWARE_SCAN_ENABLED=false

# --- 8. MEDICATION TERMINOLOGY (Phase 6) ---
MEDICATION_TERMINOLOGY_PROVIDER=local
MEDICATION_TERMINOLOGY_BASE_URL=
MEDICATION_TERMINOLOGY_API_KEY=
MEDICATION_TERMINOLOGY_TIMEOUT_SECONDS=10
MEDICATION_NORMALIZATION_ENABLED=true

# --- 9. MEDICATION SAFETY PROVIDER (Phase 7 - High-Risk Component) ---
# Licensed commercial provider (FDB, DrugBank) or mock provider for dev/testing
MEDICATION_SAFETY_ENABLED=true
MEDICATION_SAFETY_PROVIDER=mock
MEDICATION_SAFETY_BASE_URL=
MEDICATION_SAFETY_API_KEY=
MEDICATION_SAFETY_TIMEOUT_SECONDS=15
MEDICATION_SAFETY_MAX_RETRIES=2
MEDICATION_SAFETY_RESULT_TTL_SECONDS=3600

# --- 10. TRIAGE & SBAR (Phase 8) ---
TRIAGE_ENABLED=true
TRIAGE_RULE_SET=healthsetu_emergency_triage_v1
TRIAGE_RULE_SET_VERSION=1.0.0
TRIAGE_RULE_ENGINE_TIMEOUT_SECONDS=5
SBAR_ENABLED=true
SBAR_GENERATION_MODE=template

# --- 11. CARE PLAN & DISCHARGE (Phase 9) ---
CARE_PLAN_ENABLED=true
CARE_PLAN_DEFAULT_HORIZON_DAYS=30
DISCHARGE_EXTRACTION_PROVIDER=local

# --- 12. HEALTHCARE DIRECTORY & GEOGRAPHIC (Phase 11 & 12) ---
ORGANIZATION_NETWORK_ENABLED=true
FACILITY_NETWORK_ENABLED=true
HEALTHCARE_DIRECTORY_PROVIDER=none
HEALTHCARE_DIRECTORY_BASE_URL=
HEALTHCARE_DIRECTORY_API_KEY=
HEALTHCARE_DIRECTORY_TIMEOUT_SECONDS=10
FACILITY_DISCOVERY_ENABLED=true
FACILITY_DISCOVERY_MAX_RADIUS_KM=100.0
TRANSFER_ENABLED=true
TRANSFER_REQUIRE_CONSENT=true
TRANSFER_CLINICAL_CONTEXT_ENABLED=true
GEOGRAPHIC_DISTANCE_PROVIDER=local
GEOGRAPHIC_PROVIDER_BASE_URL=
GEOGRAPHIC_PROVIDER_API_KEY=
GEOGRAPHIC_PROVIDER_TIMEOUT_SECONDS=10

# --- 13. INTEROPERABILITY & FHIR (Phase 13) ---
INTEROPERABILITY_ENABLED=true
INTEROPERABILITY_PROVIDER=none
FHIR_ENABLED=true
FHIR_VERSION=R4
HL7_ENABLED=false
HL7_VERSION=
INTEROPERABILITY_BASE_URL=
INTEROPERABILITY_CLIENT_ID=
INTEROPERABILITY_CLIENT_SECRET=
INTEROPERABILITY_API_KEY=
INTEROPERABILITY_TIMEOUT_SECONDS=30
INTEROPERABILITY_MAX_RETRIES=2

# --- 14. AI & INTELLIGENCE LAYER (Phase 14) ---
AI_ENABLED=true
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2000
AI_TEMPERATURE=0.0
AI_REQUEST_RATE_LIMIT=60
AI_MAX_CONCURRENT_REQUESTS=5
AI_DATA_RETENTION_MODE=disabled
AI_TRAINING_OPT_IN=false
AI_STRUCTURED_OUTPUT_ENABLED=true
AI_GROUNDING_VALIDATION_ENABLED=true
AI_SECURITY_ENABLED=true
